{
  "server": {
    "host": "127.0.0.1",
    "port": 8000,
    "log_level": "info"
  },
  "timer": {
    "initial_seconds": 86400,
    "tick_interval_seconds": 1
  },
  "multipliers": {
    "seconds_per_follow": 300,
    "seconds_per_bit": 60,
    "seconds_per_sub": 2400,
    "seconds_per_tier2_sub": 4800,
    "seconds_per_tier3_sub": 7200,
    "seconds_per_gift_sub": 2400,
    "seconds_per_ingame_dollar": 0.015
  },
  "minecraft": {
    "enabled": true,
    "latest_log_path": "./latest.log",
    "poll_interval_seconds": 1.0,
    "process_existing_lines_on_start": false,
    "money_regex": "\\[(?P<player>.+?)\\s*->\\s*(?:Dir|You)\\]\\s*(?P<amount>[0-9]+(?:[.,][0-9]+)?)\\$\\s*erhalten"
  },
  "twitch": {
    "enabled": true,
    "client_id_env": "TWITCH_CLIENT_ID",
    "user_token_env": "TWITCH_USER_TOKEN",
    "broadcaster_user_id": "",
    "moderator_user_id": "",
    "required_scopes": [
      "bits:read",
      "channel:read:subscriptions",
      "moderator:read:followers"
    ]
  },
  "discord": {
    "enabled": true,
    "token_env": "DISCORD_BOT_TOKEN",
    "guild_id": null,
    "admin_user_ids": [],
    "token": ""
  },
  "sound": {
    "enabled": true,
    "min_bits_for_youtube": 10,
    "max_duration_seconds": 60,
    "volume": 0.75,
    "output_device_id": ""
  }
}
