# ============================================================================
# Sellout-Timer – Umgebungsvariablen
# ============================================================================
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env
#
# Alle Tokens/Secrets gehören NUR in .env, NIEMALS in config.json committen!
# ============================================================================

# --- Server -----------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_LOG_LEVEL=info

# --- Timer ------------------------------------------------------------------
TIMER_INITIAL_SECONDS=86400

# --- Twitch -----------------------------------------------------------------
TWITCH_ENABLED=false
TWITCH_CLIENT_ID=dein_client_id
TWITCH_USER_TOKEN=dein_user_token
TWITCH_BROADCASTER_ID=deine_user_id
TWITCH_MODERATOR_ID=

# --- Discord ----------------------------------------------------------------
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=dein_discord_bot_token
DISCORD_GUILD_ID=
# 👆 WICHTIG: Trage hier deine Discord Server-ID (Zahl) ein,
#    damit die Slash-Commands SOFORT erscheinen!
#    Ohne guild_id kann es bis zu 1h dauern.
#    So findest du die ID: Discord -> Server-Einstellungen -> Widget -> Server-ID
DISCORD_ADMIN_USER_IDS=

# --- Sound ------------------------------------------------------------------
SOUND_ENABLED=true
SOUND_VOLUME=0.75
SOUND_MIN_BITS_FOR_YOUTUBE=10
SOUND_MAX_DURATION_SECONDS=60
SOUND_OUTPUT_DEVICE_ID=
SOUND_PLAYBACK_MODE=python_audio_obs_video

# --- YouTube Sound / Tools --------------------------------------------------
YTDLP_PATH=
MPV_PATH=mpv
FFMPEG_PATH=ffmpeg
FFPLAY_PATH=ffplay
SOUND_PLAYER=obs
SOUND_AUTO_INSTALL_TOOLS=true
SOUND_TOOLS_DIR=tools

# --- Multiplier (optionaler Überschreibungs-Wert) ---------------------------
# Werte in config.json können pro Umgebungsvariable überschrieben werden:
# SECONDS_PER_FOLLOW=300
# SECONDS_PER_BIT=10
# SECONDS_PER_SUB=2400
# SECONDS_PER_TIER2_SUB=4800
# SECONDS_PER_TIER3_SUB=7200
# SECONDS_PER_GIFT_SUB=2400
# SECONDS_PER_INGAME_DOLLAR=0.015
